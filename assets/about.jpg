				<div class="elementor-element elementor-element-40ff3f2 elementor-widget__width-initial elementor-invisible elementor-widget elementor-widget-image" data-id="40ff3f2" data-element_type="widget" data-settings="{&quot;_animation&quot;:&quot;fadeIn&quot;}" data-widget_type="image.default">
