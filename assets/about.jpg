					<style id="wp-custom-css">
			#service{
	border-top-left-radius:50px;
	border-bottom-right-radius:50px;
	color:#324A6D;
	position: relative;
  overflow: hidden;
}
#service:after{
	content: "";
  position: absolute;
  bottom: -100%;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(228, 174, 233, 0.5);
  transition: bottom 0.5s ease-in-out;
  z-index: 0;
}
#service:hover::after{
	bottom:0;
}
#service > * {
    position: relative;
    z-index: 1;
}
#box:hover{
	background:black;
}
#box:hover .elementor-divider, #portfolio:hover .elementor-divider,
#service:hover .elementor-divider{
	animation: mymove 1s 1;
}

@keyframes mymove {
  50% {transform: rotate(360deg);}
}

#portfolio {
    position: relative;
    overflow: hidden;
}
#portfolio::after {
    content: "";
    position: absolute;
    bottom: -100%;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(228, 174, 233, 0.5);
    transition: bottom 0.5s ease-in-out;
    z-index: 0;
}
#portfolio:hover::after {
    bottom: 0;
}

#portfolio > * {
    position: relative;
    z-index: 1;
}
#portfolio:hover h1 {
   color:#646464;
	transition: 2s
}


#portfolio1 {
    position: relative;
    overflow: hidden;
}
#portfolio1::after {
    content: "";
    position: absolute;
		top: 50%;
/*     bottom: -100%; */
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(228, 174, 233, 0.5);
    transition: top 0.5s ease-in-out;
    z-index: 0;
}
#portfolio1:hover::after {
    top: 0;
}

#portfolio1 > * {
    position: relative;
    z-index: 1;
}
#portfolio1:hover h1 {
   color:#646464;
	transition: 2s
}


#job-apply-overlay {
    display: none;
}

#job-apply-popup {
    display: none;
}


#apply:target ~ #job-apply-overlay,
#apply:target ~ #job-apply-popup {
    display: block;
}

#job-apply-overlay {
    position: fixed;
    top: 0; left: 0;
    width: 100%; height: 100%;
    background: rgba(0,0,0,0.5);
    z-index: 99998;
}
#job-apply-popup {
    position: fixed;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
	height:90%;
    width: 90%;
    max-width: 600px;
    background: #fff;
    padding: 30px;
    border-radius: 12px;
    z-index: 99999;
    box-shadow: 0 0 30px rgba(0,0,0,0.3);
}


@media screen and (max-width: 768px) {

